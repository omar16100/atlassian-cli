#!/bin/sh
set -e

echo "🔍 Running pre-commit checks..."

# 1. Format check
echo "→ Checking code format..."
cargo fmt --all -- --check || {
    echo "❌ Formatting failed. Run: cargo fmt"
    exit 1
}

# 2. Clippy check
echo "→ Running clippy..."
cargo clippy --all-targets --all-features -- -D warnings || {
    echo "❌ Clippy failed. Run: cargo clippy --fix"
    exit 1
}

# 3. Quick unit tests (skip slow integration tests)
echo "→ Running unit tests..."
cargo test --lib --bins -- --test-threads=4 || {
    echo "❌ Unit tests failed"
    exit 1
}

echo "✅ Pre-commit checks passed!"
